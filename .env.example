# ============================================================
# NEXO — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no git!
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-...

# Supabase — use a chave service_role (nunca a anon no backend)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de admin (só você tem — protege endpoints de onboarding)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
NEXO_ADMIN_KEY=gere-uma-chave-forte-aqui

# Tavily — busca web para inteligência de mercado (fase 2)
# Obtenha em: https://tavily.com
# Deixe vazio para desabilitar inteligência de mercado
TAVILY_API_KEY=tvly-...
